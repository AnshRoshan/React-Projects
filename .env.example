# Copy this file to `.env` and fill in your own values.
# Every Vite env var must be prefixed with VITE_ to be exposed to the client.

# NASA APOD API key - https://api.nasa.gov/ (DEMO_KEY works for light usage)
VITE_NASA_API_KEY=DEMO_KEY

# Optional: override the base path the site is built for (defaults to /React-Projects/)
# VITE_BASE=/
