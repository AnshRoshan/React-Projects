{
	"$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": ["**", "!**/dist", "!**/node_modules"]
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"style": {
				"useSelfClosingElements": {
					"fix": "safe",
					"level": "warn"
				}
			},
			"nursery": {
				"useSortedClasses": {
					"fix": "unsafe",
					"level": "warn",
					"options": {}
				}
			},
			"a11y": {
				"useButtonType": "warn"
			},
			"security": {
				"noBlankTarget": {
					"fix": "safe",
					"level": "warn"
				}
			}
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	}
}
